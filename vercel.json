{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/ping", "dest": "/api/ping.py" },
    { "src": "/api/send", "dest": "/api/send.py" },
    { "src": "/(.*)",     "dest": "/public/$1"   }
  ]
}
